            "state": "translated",
            "value": "목록 확인 중… %lld개"
          }
        }
      }
    },
    "Screenshots": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷"
          }
        }
      }
