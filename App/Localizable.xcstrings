            "value": "%@ 보내기 (%@)"
          }
        }
      }
    },
    "Sent as “%@”. Unzip it on the device with its file manager (My Files); the files keep their dates.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 하나로 보냅니다. 기기의 내 파일 앱에서 압축을 풀면 파일 날짜가 유지됩니다."
          }
