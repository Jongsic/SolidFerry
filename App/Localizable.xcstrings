    "Turn On": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜기"
          }
        }
      }
    },
    "Turning on wireless debugging on the device…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 무선 디버깅을 켜는 중…"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 불가"
          }
        }
      }
    },
    "Unchanged": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그대로"
          }
        }
      }
    },
    "Unlock the device and choose “File transfer” in its USB notification.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 잠금을 풀고 USB 알림에서 ‘파일 전송’을 선택해 주세요."
          }
        }
      }
    },
    "Unplug and reconnect the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블을 뺐다가 다시 연결해 주세요."
          }
        }
      }
    },
    "Unplug the cable and the connection carries on over Wi-Fi.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블을 뽑으면 Wi-Fi로 이어서 연결됩니다."
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드"
          }
        }
      }
    },
    "Upload files from this Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 파일 업로드"
          }
        }
      }
    },
    "Upload to %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 업로드"
          }
        }
      }
    },
    "UPPERCASE": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문자"
          }
        }
      }
    },
    "USB cable": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 케이블"
          }
        }
      }
    },
    "USB debugging allowed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 디버깅 허용됨"
          }
        }
      }
    },
    "USB debugging is off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 디버깅 꺼짐"
          }
        }
      }
    },
    "USB debugging is off on this device. Turn it on in Developer options, or use Auto to connect with File transfer.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 USB 디버깅이 꺼져 있습니다. 개발자 옵션에서 켜거나, 자동으로 바꿔 파일 전송으로 연결하세요."
          }
        }
      }
    },
    "USB keeps dropping": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 연결이 자꾸 끊김"
          }
        }
      }
    },
    "USB keeps dropping: the connection dropped and came back several times. Try another cable or USB port, or connect directly instead of through a hub.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 연결이 자꾸 끊김: 연결이 여러 번 끊겼다 다시 잡혔습니다. 다른 케이블이나 USB 포트를 써 보거나, 허브 없이 직접 연결해 보세요."
          }
        }
      }
    },
    "USB set to File transfer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB가 파일 전송 모드"
          }
        }
      }
    },
    "Use Auto": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 바꾸기"
          }
        }
      }
    },
    "Waiting": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중"
          }
        }
      }
    },
    "Waiting for %@ to open its storage…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 저장공간을 열어 주기를 기다리는 중…"
          }
        }
      }
    },
    "Waiting for a pause in the file being transferred.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 중인 파일이 잠시 멈추길 기다리는 중입니다."
          }
        }
      }
    },
    "Waiting for access": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 허용 대기 중"
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 대기 중"
          }
        }
      }
    },
    "Waiting for the device to reconnect": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 연결 대기 중"
          }
        }
      }
    },
    "Waiting for the device to allow access.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 접근을 허용하기를 기다리는 중입니다."
          }
        }
      }
    },
    "When receiving many small files from a device over ADB, the device sends them together in one stream. Faster on some devices, slower on others; try it if receiving many small files feels slow.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB로 기기에서 작은 파일을 많이 받을 때 기기가 한 번에 이어서 보냅니다. 기기에 따라 빨라지기도 하고 느려지기도 합니다. 작은 파일을 받는 게 느리게 느껴지면 켜 보세요."
          }
        }
      }
    },
    "While this is on, Photos and Image Capture can’t import from cameras or devices on this Mac. You can turn it off here at any time. A device that’s already plugged in may need to be reconnected.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 두는 동안 이 Mac의 사진 앱과 이미지 캡처에서 카메라나 기기의 사진을 가져올 수 없습니다. 언제든 여기서 다시 끌 수 있습니다. 이미 연결된 기기는 다시 연결해야 적용될 수 있습니다."
          }
        }
      }
    },
    "Wi-Fi": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
    "Wireless debugging is on, but this Mac can’t reach the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 디버깅은 켜졌지만 이 Mac에서 기기에 닿지 않습니다."
          }
        }
      }
    },
    "Wireless debugging wasn’t allowed on the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 무선 디버깅을 허용하지 않았습니다."
          }
        }
      }
    },
    "Write new files to the device directly": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일은 기기에 바로 쓰기"
          }
        }
      }
    },
    "Written under their own name instead of a temporary one first, which is faster for many small files. If copying stops, the files being copied at that moment are left incomplete on the device; copy them again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 이름을 거치지 않고 원래 이름으로 바로 씁니다. 작은 파일이 많을 때 빨라집니다. 복사가 중단되면 그때 복사 중이던 파일만 기기에 불완전하게 남으니, 그 파일은 다시 복사하세요."
          }
        }
      }
    },
    "You choose for each file when the copy starts.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사가 시작되면 파일마다 고릅니다."
          }
        }
      }
    },
    "· %lld selected (%@)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· %lld개 선택 (%@)"
          }
        }
      }
    },
    "· loading sizes and dates": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· 크기·날짜 불러오는 중"
          }
        }
      }
    },
    "“%@” already exists": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 파일이 이미 있습니다"
          }
        }
      }
    },
    "“%@” already exists.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 이름이 이미 있습니다."
          }
        }
      }
    },
    "“%@” can’t be used as a name on the device. Names can’t contain \" : * ? < > | \\ or /.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 기기에서 이름으로 쓸 수 없습니다. 이름에는 \" : * ? < > | \\ / 를 쓸 수 없습니다."
          }
        }
      }
    },
    "“%@” changed while it was being zipped. Try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 파일이 압축하는 동안 바뀌었습니다. 다시 시도하세요."
          }
        }
      }
    },
    "%@ is connected over Wi-Fi. It’s in the sidebar.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기가 Wi-Fi로 연결되었습니다. 사이드바에서 선택하세요."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "The device and this Mac need to be on the same Wi-Fi network. Pair a device once; after that it connects whenever wireless debugging is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기와 이 Mac이 같은 Wi-Fi에 있어야 합니다. 한 번 페어링하면 그다음부터는 무선 디버깅이 켜져 있을 때 연결됩니다."
          }
        }
      }
    },
    "Pair a new device": {
      "localizations": {
