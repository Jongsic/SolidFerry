{
  "sourceLanguage": "en",
  "strings": {
    "%@ (Auto)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(자동)"
          }
        }
      }
    },
    "%@ (Fixed)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(고정)"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$lld more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 외 %lld개"
          }
        }
      }
    },
    "%@ disconnected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결 끊김"
          }
        }
      }
    },
    "%@ doesn’t exist.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 경로가 존재하지 않습니다."
          }
        }
      }
    },
    "%@ File": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일"
          }
        }
      }
    },
    "%@ is finishing an earlier request…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이전 작업을 마무리하는 중…"
          }
        }
      }
    },
    "%@ is not a folder.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 폴더가 아닙니다."
          }
        }
      }
    },
    "%@ is using the device’s file access. Quit that app to connect.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 기기의 파일 접근을 사용 중입니다. 그 앱을 종료하면 연결됩니다."
          }
        }
      }
    },
    "%@ isn’t connected. Connect it to copy these items.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 연결되어 있지 않습니다. 이 항목을 복사하려면 연결하세요."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 남음"
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/초"
          }
        }
      }
    },
    "%lld failed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 실패"
          }
        }
      }
    },
    "%lld files need your decision": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file needs your decision"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files need your decision"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개 확인 필요"
          }
        }
      }
    },
    "%lld files · %@": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file · %@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files · %@"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개 · %@"
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %lld개"
          }
        }
      }
    },
    "%lld more": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외 %lld개"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld of %lld items": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld items"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %2$lld개 중 %1$lld개"
          }
        }
      }
    },
    "%lld of %lld names change": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld names change"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld개 중 %1$lld개 이름이 바뀜"
          }
        }
      }
    },
    "(sorted when done)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(완료 후 정렬)"
          }
        }
      }
    },
    "+%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      },
      "shouldTranslate": false
    },
    "1. Install adb on this Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 이 Mac에 adb 설치"
          }
        }
      }
    },
    "2. Turn on USB debugging on the device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 기기에서 USB 디버깅 켜기"
          }
        }
      }
    },
    "6-digit code": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6자리 코드"
          }
        }
      }
    },
    "A folder has this name": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 폴더가 있음"
          }
        }
      }
    },
    "A folder with the same name exists.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 폴더가 있습니다."
          }
        }
      }
    },
    "A new folder such as “Camera (1)” is made; the existing one is left as is.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Camera (1)” 같은 새 폴더를 만들고, 기존 폴더는 그대로 둡니다."
          }
        }
      }
    },
    "A device that has wireless debugging on and has allowed this Mac stays connected after you unplug the cable.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 디버깅이 켜져 있고 이 Mac을 허용한 기기는 케이블을 뽑아도 연결이 유지됩니다."
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업"
          }
        }
      }
    },
    "ADB": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB"
          }
        }
      },
      "shouldTranslate": false
    },
    "Add to Sidebar": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에 추가"
          }
        }
      }
    },
    "Between devices, files are copied; the originals stay.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 사이에서는 복사됩니다. 원본은 그대로 남습니다."
          }
        }
      }
    },
    "Connect over USB debugging (ADB)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 디버깅(ADB)으로 연결"
          }
        }
      }
    },
    "Connecting over Wi-Fi needs adb on this Mac.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi로 연결하려면 이 Mac에 adb가 필요합니다."
          }
        }
      }
    },
    "Couldn’t install adb: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb를 설치하지 못했습니다: %@"
          }
        }
      }
    },
    "Couldn’t open %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 을(를) 열 수 없습니다."
          }
        }
      }
    },
    "Don’t Show Again": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 보지 않기"
          }
        }
      }
    },
    "Download adb from Google": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google에서 adb 내려받기"
          }
        }
      }
    },
    "Download from Google instead": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 Google에서 내려받기"
          }
        }
      }
    },
    "Downloads Android SDK Platform-Tools for this app only. By downloading, you agree to the [Android SDK terms](https://developer.android.com/studio/terms).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서만 쓸 Android SDK Platform-Tools를 내려받습니다. 내려받으면 [Android SDK 약관](https://developer.android.com/studio/terms)에 동의하는 것입니다."
          }
        }
      }
    },
    "Failed Files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 파일"
          }
        }
      }
    },
    "Favorites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색"
          }
        }
      }
    },
    "Search with a regular expression": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정규식으로 검색"
          }
        }
      }
    },
    "Install adb as shown below, or use Auto to connect with File transfer.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 안내대로 adb를 설치하거나, 자동으로 바꿔 파일 전송으로 연결하세요."
          }
        }
      }
    },
    "Install adb as shown below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 안내대로 adb를 설치하세요."
          }
        }
      }
    },
    "Install with Homebrew": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew로 설치"
          }
        }
      }
    },
    "Installing adb… This can take a few minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb 설치 중… 몇 분 걸릴 수 있습니다."
          }
        }
      }
    },
    "Needs adb": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb 필요"
          }
        }
      }
    },
    "No Matches": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 항목 없음"
          }
        }
      }
    },
    "No names in this folder contain “%@”.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 “%@”이(가) 들어간 이름이 없습니다."
          }
        }
      }
    },
    "No names in this folder match “%@”.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 “%@”과(와) 일치하는 이름이 없습니다."
          }
        }
      }
    },
    "Or choose “File transfer” in the device’s USB notification, which needs nothing installed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 기기의 USB 알림에서 “파일 전송”을 고르면 아무것도 설치하지 않아도 됩니다."
          }
        }
      }
    },
    "Remove from Sidebar": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 제거"
          }
        }
      }
    },
    "SD Card": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SD 카드"
          }
        }
      }
    },
    "Settings › About phone (on a Galaxy, › Software information): tap Build number seven times. Then Settings › Developer options: turn on USB debugging, and allow this Mac when the device asks.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › 휴대전화 정보(갤럭시는 › 소프트웨어 정보)에서 빌드번호를 일곱 번 누릅니다. 그다음 설정 › 개발자 옵션에서 USB 디버깅을 켜고, 기기가 물으면 이 Mac을 허용합니다."
          }
        }
      }
    },
    "Show All": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 보기"
          }
        }
      }
    },
    "Show How": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방법 보기"
          }
        }
      }
    },
    "Something went wrong. Try again, or reconnect the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 생겼습니다. 다시 시도하거나 기기를 다시 연결하세요."
          }
        }
      }
    },
    "Stop the transfers and quit?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송을 멈추고 종료할까요?"
          }
        }
      }
    },
    "Tap “Allow USB debugging” on the device. If it doesn’t ask, unlock it or plug the cable in again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 “USB 디버깅 허용”을 누르세요. 묻지 않으면 잠금을 풀거나 케이블을 다시 꽂으세요."
          }
        }
      }
    },
    "The connection was interrupted. Try again, or reconnect the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊어졌습니다. 다시 시도하거나 기기를 다시 연결하세요."
          }
        }
      }
    },
    "The downloaded adb isn’t signed by Google, so it wasn’t installed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내려받은 adb가 Google 서명이 아니어서 설치하지 않았습니다."
          }
        }
      }
    },
    "The download didn’t finish. Check your internet connection and try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 끝나지 않았습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "They can be resumed the next time you open the app. Files that were partly copied start over.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열면 이어서 할 수 있습니다. 복사하던 파일은 처음부터 다시 복사합니다."
          }
        }
      }
    },
    "This Mac can’t reach %@. Check that the device is on the same Wi-Fi network and that wireless debugging is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 %@에 닿지 않습니다. 기기가 같은 Wi-Fi에 있고 무선 디버깅이 켜져 있는지 확인하세요."
          }
        }
      }
    },
    "Turn on USB debugging on the device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 USB 디버깅 켜기"
          }
        }
      }
    },
    "USB Drive": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 드라이브"
          }
        }
      }
    },
    "Waiting for %@ to reconnect": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결 대기 중"
          }
        }
      }
    },
    "With USB debugging, many small files copy much faster, and files sent to this device keep their dates.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 디버깅을 켜면 작은 파일이 많을 때 훨씬 빨리 복사되고, 이 기기로 보낸 파일의 날짜도 유지됩니다."
          }
        }
      }
    },
    "With USB debugging, many small files copy much faster.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 디버깅을 켜면 작은 파일이 많을 때 훨씬 빨리 복사됩니다."
          }
        }
      }
    },
    "adb on this Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 adb"
          }
        }
      }
    },
    "adb wasn’t found. Install Android platform-tools.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb를 찾을 수 없습니다. Android platform-tools를 설치해 주세요."
          }
        }
      }
    },
    "Add numbers": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호 붙이기"
          }
        }
      }
    },
    "Add Text": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 추가"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기에 추가"
          }
        }
      }
    },
    "Add to Queue": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐에 추가"
          }
        }
      }
    },
    "Adjusted for this device": {
      "localizations": {
        "ko": {
          "stringUnit": {
